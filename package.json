{
  "name": "@httpkit/client",
  "version": "1.0.0",
  "description": "A typed HTTP client with retry, timeout, and cross-platform support. Zero external dependencies.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "jest --ci --verbose",
    "test:unit": "jest --ci --verbose --testPathPattern=tests/unit",
    "test:integration": "jest --ci --verbose --testPathPattern=tests/integration",
    "test:coverage": "jest --ci --verbose --coverage",
    "lint": "eslint src/ tests/ --ext .ts",
    "clean": "rm -rf dist/",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "http-client",
    "retry",
    "typescript",
    "cross-platform",
    "github-actions",
    "reusable-workflows"
  ],
  "author": "mruthyunjaya-lakkappanavar",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mruthyunjaya-lakkappanavar/sample-lib-node.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.6.0"
  }
}
